# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# The URL the bot opens in an incognito session.
TARGET_URL=https://example.com/app

# Credentials typed on the login screen.
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Browser options
# ---------------------------------------------------------------------------
# Keep this false. Google logins + OAuth consent usually fail in headless mode.
HEADLESS=false

# Use the locally installed Google Chrome ("chrome") instead of bundled
# Chromium (""). Chrome is recommended for Google sign-in.
BROWSER_CHANNEL=chrome

# Launch a real "New Incognito Window" (Chrome only). If this misbehaves set it
# to false: Playwright's default browser context is already a clean, cookie-less
# session that behaves like incognito.
USE_INCOGNITO_WINDOW=true

# Milliseconds of artificial delay between UI actions (helps with flaky UIs).
SLOW_MO=120

# Default timeout (ms) for waiting on elements.
TIMEOUT=45000

# ---------------------------------------------------------------------------
# Flow options
# ---------------------------------------------------------------------------
# Connector rows that must NEVER be touched (comma separated, case-insensitive,
# substring match). These are the first two entries in the connectors menu.
SKIP_CONNECTORS=Enable all connectors,Google Search

# Safety cap on how many connectors get authorized in one run.
MAX_CONNECTORS=3

# On the Google consent screen, tick the "Select all" permissions checkbox
# before clicking Allow.
SELECT_ALL_SCOPES=true

# How long (ms) the bot pauses for you to finish 2FA / a security challenge
# by hand before it gives up. Set to 0 to disable the manual wait.
MANUAL_STEP_TIMEOUT=180000

# Save a screenshot after every major step into ./runs/<timestamp>/
SCREENSHOTS=true
