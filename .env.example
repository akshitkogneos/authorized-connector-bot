# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# The URL the bot opens in an incognito session.
TARGET_URL=https://example.com/app

# Credentials typed on the login screen.
LOGIN_EMAIL=you@example.com
LOGIN_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Browser options
# ---------------------------------------------------------------------------
# Run the browsers hidden. Set false to watch them: you need a visible window
# to finish 2FA by hand, and it is the first thing to try if Google sign-in or
# OAuth consent starts failing (Google can flag headless browsers).
# `npm start -- --keep-open` always shows the browser.
HEADLESS=true

# Use the locally installed Google Chrome ("chrome") instead of bundled
# Chromium (""). Chrome is recommended for Google sign-in.
BROWSER_CHANNEL=chrome

# Launch a real "New Incognito Window" (Chrome only). If this misbehaves set it
# to false: Playwright's default browser context is already a clean, cookie-less
# session that behaves like incognito.
USE_INCOGNITO_WINDOW=true

# Milliseconds of artificial delay between UI actions (helps with flaky UIs).
SLOW_MO=120

# Default timeout (ms) for waiting on elements.
TIMEOUT=45000

# Language the browser asks websites for, e.g. en-US, es-ES, pt-BR.
# Leave empty to use this machine's default. The bot understands English,
# Spanish, Portuguese, French, German and Italian screens either way (see
# src/i18n.js); Google normally prefers the account's own saved language.
BROWSER_LOCALE=

# ---------------------------------------------------------------------------
# Flow options
# ---------------------------------------------------------------------------
# Connector rows that must NEVER be touched (comma separated, case-insensitive,
# substring match). These are the first two entries in the connectors menu.
SKIP_CONNECTORS=Enable all connectors,Google Search

# Safety cap on how many connectors get authorized in one run.
MAX_CONNECTORS=3

# Safety cap on how many skills get installed in one run.
MAX_SKILLS=10

# Which phases to run. The --connectors-only / --skills-only / --verify-only
# CLI flags override these.
DO_CONNECTORS=true
DO_SKILLS=true

# Verification: after the work is done, re-read the Sources menu and the skills
# marketplace and report any connector still un-enabled or skill still
# un-installed. Read-only - it never clicks Enable/Install.
# `npm run verify` (or --verify-only) runs this check on its own.
DO_VERIFY=true

# Optional. Names that MUST be enabled/installed for a user to count as
# verified. Leave empty to only require that the UI offers nothing more to do;
# fill them in to also catch items that are missing from the account entirely
# (so the UI never offers them). Substring match, case-insensitive.
EXPECT_CONNECTORS=
EXPECT_SKILLS=

# On the Google consent screen, tick the "Select all" permissions checkbox
# before clicking Allow.
SELECT_ALL_SCOPES=true

# How long (ms) the bot pauses for you to finish 2FA / a security challenge
# by hand before it gives up. Set to 0 to disable the manual wait.
MANUAL_STEP_TIMEOUT=180000

# Save a screenshot after every major step into ./runs/<timestamp>/
SCREENSHOTS=true

# ---------------------------------------------------------------------------
# Batch mode (npm run batch, and npm start when the CSV has rows)
# ---------------------------------------------------------------------------
# CSV of accounts to process. Needs Email and Password columns; a Status
# column is honoured (only "Active" rows run unless you pass --all).
#
# NOTE: if this file exists and has at least one usable row, plain `npm start`
# runs BATCH mode and ignores LOGIN_EMAIL / LOGIN_PASSWORD above.
# Use `npm start -- --single` to sign in with the .env account instead.
USERS_CSV=data/users.csv

# Minimum gap (ms) between two users starting their sign-in, so the browsers
# open one after another rather than all at once - Google treats a burst of
# logins from one IP as suspicious. With PARALLEL=1 it is instead the pause
# between one user finishing and the next one starting.
BATCH_DELAY=5000

# How many users to process at the same time, each in its own browser window
# (1 = one after another). Users never share a browser, so they cannot affect
# each other; the limits are this machine (budget ~0.5-1 GB RAM per window)
# and how many simultaneous sign-ins Google tolerates from one IP.
# Override it for a single run by adding parallel=N at the end of the command:
#   npm start parallel=3
#   npm run verify parallel=2
PARALLEL=5

# ---------------------------------------------------------------------------
# Web UI (npm run ui)
# ---------------------------------------------------------------------------
# Port for the local web UI. Default: 5700, or the next free port up to 5709.
# Set it to pin one port (the UI then refuses to start if it is taken).
# UI_PORT=5700

# Open the UI in your default browser when it starts (set false to skip).
# UI_OPEN=true
